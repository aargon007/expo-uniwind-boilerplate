{
    "expo": {
        "name": "Uniwind",
        "slug": "uniwind",
        "version": "1.0.0",
        "scheme": "uniwind",
        "orientation": "portrait",
        "userInterfaceStyle": "automatic",
        "icon": "./assets/icon.png",
        "assetBundlePatterns": ["**/*"],
        "ios": {
            "supportsTablet": true,
            "requireFullScreen": true,
            "config": {
                "usesNonExemptEncryption": false
            },
            "bundleIdentifier": "com.uniwind.app"
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#000000"
            },
            "package": "com.uniwind.app"
        },
        "web": {
            "bundler": "metro",
            "favicon": "./assets/icon.png"
        },
        "plugins": [
            "expo-font",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/splash.png",
                    "imageWidth": 200,
                    "resizeMode": "contain",
                    "backgroundColor": "#090909"
                }
            ]
        ],
        "extra": {
            "eas": {
                "projectId": ""
            }
        }
    }
}
