{
    "name": "expo-uniwind-boilerplate",
    "version": "1.0.0",
    "description": "A React Native Expo boilerplate with TypeScript, Uniwind support.",
    "license": "MIT",
    "author": "Md Muhaiminul",
    "main": "index.ts",
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "web:build": "expo export -p web",
        "web:preview": "npx serve dist",
        "ts:check": "tsc --noEmit",
        "lint": "eslint .",
        "clean": "npx expo prebuild --clean",
        "update": "npx expo install --check",
        "devbuild:ios": "eas build -p ios --profile development",
        "devbuild:android": "eas build -p android --profile development",
        "devbuild:all": "eas build -p all --profile development",
        "build:ios": "eas build -p ios --profile production",
        "build:android": "eas build -p android --profile production",
        "submit:ios": "eas submit -p ios --latest",
        "submit:android": "eas submit -p android --latest",
        "submit:all": "eas submit --platform all",
        "format": "prettier --write .",
        "lint:fix": "eslint . --fix",
        "test": "jest",
        "test:ci": "jest --runInBand",
        "format:check": "prettier --check .",
        "doctor": "npx expo-doctor"
    },
    "dependencies": {
        "@expo/metro-runtime": "~58.0.14",
        "@expo/ui": "~58.0.20",
        "@expo/vector-icons": "^15.1.1",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-navigation/bottom-tabs": "^7.21.0",
        "@react-navigation/native": "^7.5.1",
        "@react-navigation/native-stack": "^7.21.0",
        "@tanstack/react-query": "^5.104.4",
        "axios": "^1.20.0",
        "clsx": "^2.1.1",
        "expo": "~58.0.0",
        "expo-constants": "~58.0.12",
        "expo-dev-client": "~58.0.14",
        "expo-font": "~58.0.8",
        "expo-network": "~58.0.3",
        "expo-splash-screen": "~58.0.10",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-native": "0.88.0",
        "react-native-gesture-handler": "~3.3.0",
        "react-native-keyboard-controller": "1.22.7",
        "react-native-reanimated": "4.7.1",
        "react-native-safe-area-context": "~5.10.1",
        "react-native-screens": "~4.30.0",
        "react-native-svg": "15.16.0",
        "react-native-web": "^0.21.4",
        "react-native-worklets": "0.13.0",
        "sonner-native": "^0.27.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "uniwind": "^1.12.2",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@eslint/compat": "^2.1.0",
        "@react-native/jest-preset": "0.88.0",
        "@tanstack/eslint-plugin-query": "^5.104.4",
        "@testing-library/react-native": "^14.1.0",
        "@types/react": "~19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.60.0",
        "@typescript-eslint/parser": "^8.60.0",
        "eslint": "^10.4.0",
        "eslint-config-universe": "^15.2.0",
        "globals": "^17.13.0",
        "jest": "~30.5.2",
        "jest-expo": "~58.0.11",
        "prettier": "^3.8.1",
        "test-renderer": "^1.3.1",
        "typescript": "~6.0.3",
        "@jest/globals": "~30.5.2"
    },
    "private": true,
    "packageManager": "yarn@1.22.22",
    "engines": {
        "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
    }
}
